# Optional AI explanations (the scientific pipeline needs NONE of this).
# Copy to .env, fill in, and export. Never commit a real key.
#
# Modes: off (default) | ollama (alias: local) | openai | anthropic |
#        openrouter | custom (any OpenAI-compatible endpoint)
#
# Local Ollama (free; no API key, no --allow-chargeable needed):
#   ollama serve
#   ollama pull gemma2:2b
#   EVBATT_AI_PROVIDER=ollama EVBATT_AI_MODEL=gemma2:2b evbatt ai test
EVBATT_AI_PROVIDER=off
# EVBATT_AI_BASE_URL=http://localhost:11434/v1   # default for ollama; required for custom
# EVBATT_AI_API_KEY=                              # not needed for local endpoints
# EVBATT_AI_MODEL=gemma2:2b                       # see `evbatt ai models`
# EVBATT_AI_TIMEOUT_SEC=60
#
# Cost is never guessed. Supply your provider's current prices if you
# want an estimate (USD per million tokens):
# EVBATT_AI_INPUT_COST_PER_MTOK=
# EVBATT_AI_OUTPUT_COST_PER_MTOK=
